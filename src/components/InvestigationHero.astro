---
// Abstract, editorial diagram: an inherited system (irregular modules, not
// all equally understood) surrounded by distinct evidence sources, with
// dashed lines converging on the one module the evidence has narrowed the
// investigation toward. No people, no embedded text — see
// docs/course-design.md on visual language matching the writing voice.
---

<figure class="investigation-hero">
  <svg
    viewBox="0 0 640 380"
    role="img"
    aria-labelledby="investigation-hero-title"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="investigation-hero-title">
      Diagram of an inherited system: a boundary containing modules of
      varying familiarity, surrounded by four distinct evidence
      sources — version history, logs, runtime traces, and direct
      observation — connected by lines that converge on the one module the
      evidence has narrowed the investigation toward.
    </title>

    <!-- system boundary -->
    <rect
      x="170" y="40" width="300" height="220" rx="4"
      fill="none" stroke="var(--at-text-muted)" stroke-width="1.5"
      stroke-dasharray="5 4"
    />

    <!-- convergence lines from evidence sources to the narrowed module -->
    <g stroke="var(--at-text-muted)" stroke-width="1" stroke-dasharray="3 3" fill="none">
      <path d="M 78 78 L 278 128" />
      <path d="M 562 78 L 300 122" />
      <path d="M 78 302 L 268 148" />
      <path d="M 562 302 L 305 150" />
    </g>

    <!-- module graph inside the boundary -->
    <g fill="none" stroke="var(--at-text-muted)" stroke-width="1.25">
      <rect x="190" y="60" width="70" height="40" />
      <rect x="270" y="60" width="90" height="30" />
      <rect x="370" y="55" width="70" height="50" fill="var(--at-bg-alt)" />
      <rect x="190" y="115" width="50" height="60" />
      <rect x="320" y="120" width="55" height="45" />
      <rect x="385" y="115" width="65" height="70" fill="var(--at-bg-alt)" />
      <rect x="190" y="185" width="90" height="50" />
      <rect x="290" y="180" width="70" height="60" />
      <rect x="370" y="195" width="80" height="45" />
    </g>

    <!-- the module the evidence has narrowed onto -->
    <rect
      x="250" y="110" width="60" height="35"
      fill="var(--at-accent-soft)" stroke="var(--at-accent)" stroke-width="2"
    />

    <!-- control-flow connectors between modules -->
    <g stroke="var(--at-border)" stroke-width="1" fill="none">
      <path d="M 260 80 L 270 80" />
      <path d="M 360 75 L 370 78" />
      <path d="M 215 100 L 215 115" />
      <path d="M 240 132 L 250 128" />
      <path d="M 310 127 L 320 135" />
      <path d="M 375 142 L 385 145" />
      <path d="M 215 175 L 215 185" />
      <path d="M 280 210 L 290 210" />
      <path d="M 360 215 L 370 215" />
    </g>

    <!-- evidence source: version history -->
    <g transform="translate(60, 70)" stroke="var(--at-secondary)" stroke-width="1.5" fill="none">
      <circle r="18" />
      <path d="M 0 0 L 0 -10" />
      <path d="M 0 0 L 7 5" />
    </g>

    <!-- evidence source: logs -->
    <g transform="translate(545, 52)" stroke="var(--at-secondary)" stroke-width="1.5" fill="none">
      <rect x="0" y="0" width="34" height="42" rx="2" />
      <path d="M 7 12 L 27 12" />
      <path d="M 7 21 L 27 21" />
      <path d="M 7 30 L 20 30" />
    </g>

    <!-- evidence source: runtime traces -->
    <g transform="translate(60, 285)" stroke="var(--at-secondary)" stroke-width="1.5" fill="none">
      <path d="M 0 15 L 0 30" />
      <path d="M 9 5 L 9 30" />
      <path d="M 18 20 L 18 30" />
      <path d="M 27 0 L 27 30" />
      <path d="M 36 10 L 36 30" />
    </g>

    <!-- evidence source: direct observation -->
    <g transform="translate(548, 288)" stroke="var(--at-primary)" stroke-width="1.5" fill="none">
      <circle cx="10" cy="10" r="12" />
      <path d="M 19 19 L 30 30" stroke-linecap="round" />
    </g>
  </svg>
</figure>

<style>
  .investigation-hero {
    margin: 0 0 2rem;
  }

  .investigation-hero svg {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin-inline: auto;
  }
</style>
