---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { withBase } from "astro-theme-university/url";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    Twelve weeks, each opening from a specific failure rather than a topic.
    Scaffolding is heaviest in Weeks 1–2 and withdraws steadily from there;
    Week 12 has none. Titles below are questions, not chapter headings — the
    setting changes week to week, but the six-stage investigative cycle does
    not. Incident details are deliberately withheld here; see
    <a href={withBase("/course/")}>Course Overview</a> for the method itself.
  </p>
  <SessionsGrid />
</ContentLayout>
